# ==============================================================================
# AI Customer Support SaaS — Environment variables (template)
# Copy to `.env` (root, for docker compose) and per-workspace copies:
#   server/.env, client/.env
# NEVER commit real .env files.
# ==============================================================================

# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
LOG_LEVEL=info

# ── Database (MongoDB) ─────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/ai_support_saas

# ── HTTP / CORS ────────────────────────────────────────────────────────────────
# Comma-separated origins allowed by CORS (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Browser URL of the SPA (used for CORS allow-list and future email links)
CLIENT_URL=http://localhost:5173

# ── API ────────────────────────────────────────────────────────────────────────
API_PREFIX=/api/v1

# ── Rate limiting ───────── tunable without redeploying code ───────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# ── Authentication (required in production — enforced at boot) ────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# One-time email tokens (cryptographically random, hashed at rest)
AUTH_VERIFY_EMAIL_TTL=24h
AUTH_PASSWORD_RESET_TTL=1h

# ── Refresh-token cookie ────────────────────────────────────────────────────────
# secure: "auto" sets Secure only when NODE_ENV=production
COOKIE_SECURE=auto
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com   # uncomment only when serving the API from a subdomain

# ── Email delivery ──────────────────────────────────────────────────────────────
# "log" is a dev-only outbox (auth emails are written to the server log).
# Production REQUIRES a real provider (smtp|ses) — boot fails with "log".
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ── AI providers (populate in the AI phase) ────────────────────────────────────
AI_PROVIDER=none
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── AWS (populate in the storage/deploy phase) ────────────────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_DOCUMENTS=

# ── Real-time (reserved for the sockets phase) ─────────────────────────────────
SOCKET_PATH=/realtime

# ── Client (Vite: only VITE_* vars are exposed to the browser) ─────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=AI Customer Support SaaS
VITE_SOCKET_URL=http://localhost:8000
