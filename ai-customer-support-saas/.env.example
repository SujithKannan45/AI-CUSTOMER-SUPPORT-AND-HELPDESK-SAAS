# ==============================================================================
# AI Customer Support SaaS — Environment variables (template)
# Copy to `.env` (root, for docker compose) and per-workspace copies:
#   server/.env, client/.env
# NEVER commit real .env files.
# ==============================================================================

# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
LOG_LEVEL=info

# ── Database (MongoDB) ─────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/ai_support_saas

# ── HTTP / CORS ────────────────────────────────────────────────────────────────
# Comma-separated origins allowed by CORS (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Browser URL of the SPA (used for CORS allow-list and future email links)
CLIENT_URL=http://localhost:5173

# ── API ────────────────────────────────────────────────────────────────────────
API_PREFIX=/api/v1

# ── Rate limiting ───────── tunable without redeploying code ───────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# ── Authentication (required in production — enforced at boot) ────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# One-time email tokens (cryptographically random, hashed at rest)
AUTH_VERIFY_EMAIL_TTL=24h
AUTH_PASSWORD_RESET_TTL=1h

# ── Refresh-token cookie ────────────────────────────────────────────────────────
# secure: "auto" sets Secure only when NODE_ENV=production
COOKIE_SECURE=auto
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com   # uncomment only when serving the API from a subdomain

# ── Email delivery ──────────────────────────────────────────────────────────────
# "log" is a dev-only outbox (auth emails are written to the server log).
# Production REQUIRES a real provider (smtp|ses) — boot fails with "log".
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ── AI chat provider (Prompt 14 — support agent) ──────────────────────────────
# "none" (default) keeps agent endpoints safely unconfigured (they answer 503
# AGENT_AI_NOT_CONFIGURED). "openai" uses the OpenAI-compatible chat API
# (AI_CHAT_BASE_URL, AI_CHAT_MODEL). "gemini"/"bedrock" are RESERVED enum
# values whose adapters are not implemented yet.
# Production requires OPENAI_API_KEY when AI_PROVIDER=openai.
AI_PROVIDER=none
OPENAI_API_KEY=
GEMINI_API_KEY=
# OpenAI-compatible chat endpoint base (proxy-friendly).
AI_CHAT_BASE_URL=https://api.openai.com/v1
# Generation model id (configurable; live behavior UNVERIFIED until a real
# key is set — the agent driver tests use the deterministic mock provider).
AI_CHAT_MODEL=gpt-4o-mini
# Per-call chat provider timeout (ms) and hard completion-token cap.
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=512
# Agent request bounds (abuse guards) and answerability policy:
AI_AGENT_QUESTION_MAX_CHARS=2000
# Conversation-history grounding bounds (PUBLIC messages only — internal
# staff notes are excluded in-query and never enter agent context).
AI_AGENT_HISTORY_MAX_MESSAGES=10
AI_AGENT_HISTORY_MESSAGE_MAX_CHARS=2000
# Evidence gate: answerability comes only from MEASURED signals (retrieval
# passage count, similarity floor, citation validity). Model self-reported
# confidence is never trusted.
AI_AGENT_MIN_PASSAGES=1
AI_AGENT_MIN_CONTEXT_SCORE=0.1
# Context bounds — AI_AGENT_CONTEXT_MAX_PASSAGES MUST be <= RAG_MAX_RETRIEVE_LIMIT
# (boot fails otherwise).
AI_AGENT_CONTEXT_MAX_PASSAGES=5
AI_AGENT_CONTEXT_MAX_CHARS=6000
AI_AGENT_ANSWER_MAX_CHARS=2000

# ── AI/RAG foundation (Prompt 13) ─────────────────────────────────────────────
# Embedding provider: "none" (default — indexing stays dormant), "openai"
# (requires OPENAI_API_KEY), or "mock" (deterministic TESTS/DEV ONLY —
# production boot refuses it).
RAG_EMBEDDING_PROVIDER=none
RAG_EMBEDDING_MODEL=text-embedding-3-small
# Vector dimensionality — MUST match the selected vector store configuration.
RAG_EMBEDDING_DIMENSIONS=1536
RAG_EMBEDDING_BATCH_SIZE=64
RAG_EMBEDDING_TIMEOUT_MS=30000
RAG_EMBEDDING_INPUT_MAX_CHARS=8000
# OpenAI-compatible embeddings endpoint base (no secret; proxy-friendly).
RAG_OPENAI_BASE_URL=https://api.openai.com/v1
# Vector search implementation: "none" (default), "atlas" (MongoDB Atlas
# Vector Search — requires a MANUALLY created Atlas Search vector index on
# the rag_chunks collection, see docs/architecture.md), or "inmemory"
# (tests/dev ONLY — production refuses it unless explicitly allowed).
RAG_VECTOR_SEARCH=none
RAG_ATLAS_VECTOR_INDEX=rag_chunks_vector
RAG_ALLOW_INMEMORY_VECTOR_PRODUCTION=false
# Retrieval bounds: query length, max results per retrieval call, similarity
# floor (0 disables the floor).
RAG_QUERY_MAX_LENGTH=1000
RAG_MAX_RETRIEVE_LIMIT=10
RAG_MIN_SCORE=0
# Chunking bounds: chunk size and cross-chunk overlap (overlap MUST be
# strictly smaller than chunk size). Sources above RAG_MAX_SOURCE_CHARS are
# rejected, never silently truncated.
RAG_CHUNK_MAX_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=150
RAG_MAX_SOURCE_CHARS=300000

# ── AWS (populate for the S3 storage driver) ─────────────────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_DOCUMENTS=

# ── Document/file storage (Prompt 12) ────────────────────────────────────────
# Driver selection: "local" (development default) or "s3" (production).
STORAGE_PROVIDER=local
# Local driver root ( Mavericks-safe relative path; git-ignored).
STORAGE_DATA_DIR=./data/files
# Hard cap per uploaded file (bytes).
FILE_UPLOAD_MAX_BYTES=10485760
# ONLY set TRUE when local disk is an explicit production decision.
STORAGE_ALLOW_LOCAL_PRODUCTION=false

# ── Real-time (reserved for the sockets phase) ─────────────────────────────────
SOCKET_PATH=/realtime

# ── Client (Vite: only VITE_* vars are exposed to the browser) ─────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=AI Customer Support SaaS
VITE_SOCKET_URL=http://localhost:8000
