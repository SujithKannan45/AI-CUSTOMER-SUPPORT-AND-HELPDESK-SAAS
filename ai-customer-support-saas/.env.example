# ==============================================================================
# AI Customer Support SaaS — Environment variables (template)
# Copy to `.env` (root, for docker compose) and per-workspace copies:
#   server/.env, client/.env
# NEVER commit real .env files.
# ==============================================================================

# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
LOG_LEVEL=info
# Comma-separated origins allowed by CORS (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Database (MongoDB) ─────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/ai_support_saas
# docker-compose service name resolves to `mongo`; use this when running the
# server outside Docker while the DB runs in Docker:
# MONGODB_URI=mongodb://localhost:27017/ai_support_saas

# ── Authentication (reserved for a later phase — do not ship real values) ──────
JWT_ACCESS_SECRET=replace-with-64-char-random-hex
JWT_REFRESH_SECRET=replace-with-different-64-char-random-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── AI providers (reserved — populate in the AI phase) ─────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── AWS (reserved — populate in the storage/deploy phase) ──────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_DOCUMENTS=
S3_BUCKET_EXPORTS=

# ── Real-time (reserved for the sockets phase) ─────────────────────────────────
SOCKET_PATH=/realtime

# ── Client (Vite: only VITE_* vars are exposed to the browser) ─────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=AI Customer Support SaaS
VITE_SOCKET_URL=http://localhost:8000
